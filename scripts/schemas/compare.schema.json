{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "compare.schema.json",
  "title": "对比页装配产物 — 上半各家决断卡并排(零新判断)+ 下半组内裁决(票 10)",
  "description": "上半的每一格都搬自各家最新 run 的装配产物与节点 YAML 块, 这里不新增任何判断;下半 judge 是唯一的判断节点, 由 compare-judge 写、过 compare-judge.schema.json。verdict_card / top3 / anchor_range 直接 $ref 单报告侧的定义, 不留第二份真相源。",
  "type": "object",
  "required": [
    "group",
    "generated",
    "stale_threshold_days",
    "members",
    "missing_members"
  ],
  "properties": {
    "group": {
      "type": "object",
      "required": [
        "slug",
        "name",
        "anchor"
      ],
      "properties": {
        "slug": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "anchor": {
          "type": "string",
          "minLength": 1
        },
        "chain_note": {
          "type": "string"
        }
      }
    },
    "generated": {
      "$ref": "common.schema.json#/$defs/iso_date"
    },
    "stale_threshold_days": {
      "type": "integer",
      "minimum": 1,
      "description": "基准日超过这个天数标「陈旧」并提示先 --review(spec 定 90 天 ≈ 一个披露季)"
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "company",
          "ticker",
          "report_date",
          "run_type",
          "age_days",
          "stale",
          "action_gear",
          "quality_field",
          "verdict_card",
          "top3"
        ],
        "properties": {
          "company": {
            "type": "string",
            "minLength": 1
          },
          "ticker": {
            "type": "string"
          },
          "market": {
            "type": [
              "string",
              "null"
            ]
          },
          "is_anchor": {
            "type": "boolean"
          },
          "report_date": {
            "$ref": "common.schema.json#/$defs/iso_date"
          },
          "run_type": {
            "enum": [
              "full",
              "incremental"
            ]
          },
          "age_days": {
            "type": "integer",
            "minimum": 0
          },
          "stale": {
            "type": "boolean",
            "description": "true → 页面标「陈旧」并提示先 --review 再比"
          },
          "action_gear": {
            "$ref": "common.schema.json#/$defs/action_gear"
          },
          "quality_field": {
            "type": "string",
            "minLength": 1
          },
          "verdict_plain": {
            "type": "string"
          },
          "verdict_card": {
            "$ref": "assembly.schema.json#/properties/verdict_card"
          },
          "top3": {
            "$ref": "assembly.schema.json#/properties/top3"
          },
          "anchor_range": {
            "$ref": "node-odds.schema.json#/properties/anchor_range"
          },
          "current_price": {
            "$ref": "node-odds.schema.json#/properties/current_price"
          },
          "next_disclosure_date": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/iso_date"
              },
              {
                "type": "null"
              }
            ]
          },
          "red_flag_counts": {
            "type": "object",
            "description": "各级红旗条数(附录D 清单机器计数, 不新增判断)",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          },
          "report_href": {
            "type": "string",
            "description": "站点相对链接, 点回这家的单报告"
          },
          "report_md": {
            "type": "string",
            "description": "本地主报告 md 路径"
          },
          "degraded": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "这家有哪几格没搬过来(读不出/不合契约)—— 留空可以, 不说才是问题"
          }
        }
      }
    },
    "missing_members": {
      "type": "array",
      "description": "成组时列出来的缺报告成员 —— 全报告制不给它们凑数, 由用户决定分批补跑哪几家",
      "items": {
        "type": "object",
        "required": [
          "company",
          "ticker",
          "reason"
        ],
        "properties": {
          "company": {
            "type": "string",
            "minLength": 1
          },
          "ticker": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "string",
            "description": "补跑这家的命令"
          }
        }
      }
    },
    "judge": {
      "$ref": "compare-judge.schema.json"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "机器提示(陈旧成员 / 缺报告 / 裁决未产出), 页面顶部原样展示"
    }
  }
}
