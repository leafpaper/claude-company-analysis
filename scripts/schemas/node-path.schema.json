{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "node-path.schema.json",
  "title": "④路径节点 YAML verdict 块 — 扛得住吗;证伪清单与左尾清单权威",
  "allOf": [{ "$ref": "common.schema.json#/$defs/node_base" }],
  "required": ["node", "verdict", "sub_verdicts", "red_flag_nominations", "falsifications", "left_tail"],
  "properties": {
    "node": { "const": "path" },
    "sub_verdicts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/sub_verdict" }
    },
    "falsifications": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["condition"],
        "properties": {
          "condition": { "type": "string", "minLength": 1 },
          "triggered": { "type": ["boolean", "null"] }
        }
      }
    },
    "left_tail": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["scenario"],
        "properties": {
          "scenario": { "type": "string", "minLength": 1 },
          "note": { "type": "string" }
        }
      }
    }
  }
}
