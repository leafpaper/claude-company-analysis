{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "node-odds.schema.json",
  "title": "③赔率节点 YAML verdict 块 — 贵不贵;区间锚[SOTP,DCF]两端同向规则",
  "allOf": [{ "$ref": "common.schema.json#/$defs/node_base" }],
  "required": ["node", "verdict", "sub_verdicts", "red_flag_nominations", "anchor_range"],
  "properties": {
    "node": { "const": "odds" },
    "sub_verdicts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/sub_verdict" }
    },
    "current_price": {
      "type": "object",
      "required": ["value"],
      "properties": {
        "value": { "type": "number" },
        "unit": { "type": "string" }
      }
    },
    "anchor_range": {
      "type": "object",
      "required": ["low", "high", "same_direction"],
      "properties": {
        "low": { "$ref": "#/$defs/anchor_point" },
        "high": { "$ref": "#/$defs/anchor_point" },
        "same_direction": { "type": "boolean" },
        "divergence_note": { "type": "string", "minLength": 1 }
      },
      "if": {
        "properties": { "same_direction": { "const": false } },
        "required": ["same_direction"]
      },
      "then": { "required": ["divergence_note"] }
    }
  },
  "$defs": {
    "anchor_point": {
      "type": "object",
      "required": ["method", "value"],
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "value": { "type": "number" },
        "unit": { "type": "string" }
      }
    }
  }
}
