{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "node-state.schema.json",
  "title": "②状态节点 YAML verdict 块 — 在变好吗;「该等什么」全链唯一产出处",
  "allOf": [{ "$ref": "common.schema.json#/$defs/node_base" }],
  "required": ["node", "verdict", "sub_verdicts", "red_flag_nominations", "critical_point"],
  "properties": {
    "node": { "const": "state" },
    "sub_verdicts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/sub_verdict" }
    },
    "critical_point": {
      "type": "object",
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
