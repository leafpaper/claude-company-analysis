{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "triage.schema.json",
  "title": "增量复查分诊单 triage.json — R2 纯脚本产物(标脏机检/重评波次/指标 diff/建议档)",
  "type": "object",
  "required": [
    "company", "date", "prev_run_date", "quality",
    "rerun_nodes", "reused_nodes", "waves",
    "new_pdfs", "annual_disclosed", "metric_deltas", "red_flag_diff",
    "falsification_checklist", "critical_points", "full_rerun_advice", "summary"
  ],
  "properties": {
    "company": { "type": "string", "minLength": 1 },
    "date": { "$ref": "common.schema.json#/$defs/iso_date" },
    "prev_run_date": { "$ref": "common.schema.json#/$defs/iso_date" },
    "prev_run_type": { "enum": ["full", "incremental"] },
    "quality": {
      "type": "object",
      "required": ["dirty", "rules"],
      "properties": {
        "dirty": { "type": "boolean" },
        "rules": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": ["rule", "triggered", "evidence"],
            "properties": {
              "rule": { "enum": ["annual_report", "segment_band", "new_quality_flag", "evidence_sign_flip"] },
              "triggered": { "type": ["boolean", "null"] },
              "evidence": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "rerun_nodes": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["quality", "state", "odds", "path", "decision"] }
    },
    "reused_nodes": {
      "type": "array",
      "items": { "enum": ["quality", "state", "odds", "path", "decision"] }
    },
    "waves": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": { "enum": ["quality", "state", "odds", "path", "decision"] }
      }
    },
    "agents": {
      "type": "array",
      "items": { "type": "array", "items": { "type": "string" } }
    },
    "new_pdfs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "annual_disclosed": { "type": "boolean" },
    "metric_deltas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "before", "after"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "before": { "type": "string" },
          "after": { "type": "string" }
        }
      }
    },
    "red_flag_diff": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "change"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "change": { "enum": ["triggered", "resolved", "level_changed"] },
          "note": { "type": "string" }
        }
      }
    },
    "falsification_checklist": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["condition"],
        "properties": {
          "condition": { "type": "string", "minLength": 1 },
          "prev_triggered": { "type": ["boolean", "null"] }
        }
      }
    },
    "critical_points": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "full_rerun_advice": {
      "type": "object",
      "required": ["advised", "reasons"],
      "properties": {
        "advised": { "type": "boolean" },
        "reasons": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "summary": { "type": "string", "minLength": 1 }
  }
}
