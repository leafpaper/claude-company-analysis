{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "title": "v8 契约层共享定义(红旗条目/面板指标/最硬证据/子判定/三元组/节点基座)",
  "$defs": {
    "red_flag_item": {
      "type": "object",
      "required": ["id", "level", "title", "evidence", "source", "node"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "level": { "enum": ["🔴", "🟠", "🟡", "🟢", "ℹ️"] },
        "title": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 },
        "source": { "enum": ["script", "nomination"] },
        "node": { "enum": ["quality", "state", "odds", "path"] },
        "metric_refs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "panel_indicator": {
      "type": "object",
      "required": ["name", "value", "trend", "peer_percentile", "red_flag_ref", "note"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 },
        "trend": { "type": "string", "minLength": 1 },
        "peer_percentile": { "type": ["string", "null"] },
        "red_flag_ref": { "type": ["string", "null"] },
        "note": { "type": ["string", "null"] }
      }
    },
    "hardest_evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["text", "mechanism"],
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "mechanism": { "type": "string", "minLength": 1 }
        }
      }
    },
    "sub_verdict": {
      "type": "object",
      "required": ["question", "judgment", "hardest_evidence"],
      "properties": {
        "question": { "type": "string", "minLength": 1 },
        "judgment": { "type": "string", "minLength": 1 },
        "hardest_evidence": { "$ref": "#/$defs/hardest_evidence" }
      }
    },
    "triad": {
      "type": "object",
      "required": ["state", "odds", "path"],
      "properties": {
        "state": { "type": "string", "minLength": 1 },
        "odds": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "node_base": {
      "type": "object",
      "required": ["node", "verdict"],
      "properties": {
        "verdict": { "type": "string", "minLength": 1 },
        "reused_from": {
          "anyOf": [
            { "$ref": "#/$defs/iso_date" },
            { "type": "null" }
          ]
        },
        "red_flag_nominations": {
          "type": "array",
          "items": { "$ref": "#/$defs/red_flag_item" }
        }
      }
    },
    "iso_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "action_gear": { "enum": ["核心仓", "期权仓", "等证据临界", "不追高", "减仓", "回避"] }
  }
}
